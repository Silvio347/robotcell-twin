# Copy to .env.local. Only non-secret values go here: anything prefixed with
# VITE_ is embedded in the public JS bundle.

# Same HiveMQ Cloud broker used by Fluxio (MQTT over secure WebSockets).
VITE_MQTT_URL=wss://<cluster-id>.s1.eu.hivemq.cloud:8884/mqtt

# Root of every topic used by the twin. Keeps it apart from Fluxio's device/<id>/... topics.
VITE_TOPIC_PREFIX=robotcell
