 ********************************************************************
 * Local variables of program NewProgram
 ********************************************************************)
(* I/O, mapped in IoMap.iom (Table I of the cell handout) *)
VAR
	Emergencia : BOOL;
	Jaka_DO7 : BOOL; (*DONE: plate on the conveyor*)
	Jaka_DO6 : BOOL; (*spare*)
	Jaka_DO5 : BOOL; (*pulse: plate gripped (twin only)*)
	Jaka_DI3 : BOOL; (*CMD: put the plate on the conveyor*)
	Jaka_DI2 : BOOL; (*enable*)
	Jaka_DI1 : BOOL; (*spare*)
	Staubli_DO4 : BOOL; (*DONE: plate on the table, parts on the board*)
	Staubli_DO5 : BOOL; (*DONE: squares drawn, marker stored*)
	Staubli_DO6 : BOOL; (*pulse: one part placed*)
	Staubli_DO7 : BOOL; (*pulse: one square drawn*)
	Staubli_DI12 : BOOL; (*CMD: plate to the table, parts to the board*)
	Staubli_DI13 : BOOL; (*enable*)
	Staubli_DI14 : BOOL; (*CMD: pick the marker and draw*)
	Staubli_DI15 : BOOL; (*spare*)
	Esteira_StaubliJaka : BOOL; (*spare*)
	Esteira_JakaStaubli : BOOL; (*carries the plate to the Staubli*)
	Sensor_Jaka : BOOL;
	Sensor_Staubli : BOOL;
END_VAR
(* Sequence *)
VAR
	Ligar : BOOL; (*start request from the HMI, cleared at the end of the cycle*)
	Etapa : INT; (*0 idle, 1 plate to Staubli, 2 parts to board, 3 wait, 4 drawing, 5 finishing*)
	PlacaNaEsteira : BOOL;
	PlacaChegou : BOOL;
	PecasNoQuadro : BOOL;
	CicloConcluido : BOOL;
	iContador : INT; (*completed cycles*)
	PulsoPeca : R_TRIG;
	PulsoQuadrado : R_TRIG;
	TempoCiclo : TON;
END_VAR
(* HMI (Init_Page) *)
VAR
	iPecasNoQuadro : INT; (*0..2*)
	iQuadrados : INT; (*0..2*)
	iTempoCiclo_s : INT; (*seconds*)
	iPlaca : INT; (*plate: 0 Jaka, 1 conveyor, 2 Staubli*)
	iProgresso : INT; (*0..4*)
	iCorJaka : INT;
	iCorEsteira : INT;
	iCorPecas : INT;
	iCorDesenho : INT;
	iCorConcluido : INT;
	iCorPeca1 : INT;
	iCorPeca2 : INT;
	iCorQuadrado1 : INT;
	iCorQuadrado2 : INT;
	iCorPlacaJaka : INT;
	iCorPlacaEsteira : INT;
	iCorPlacaStaubli : INT;
	iCorEmergencia : INT;
END_VAR
(* HMI palette indexes (Palette.vcr) *)
VAR CONSTANT
	COR_ESPERA : INT := 250; (*light grey: waiting*)
	COR_ANDAMENTO : INT := 46; (*yellow: running*)
	COR_FEITO : INT := 155; (*green: done*)
	COR_ALARME : INT := 51; (*red*)
	COR_PECA : INT := 204; (*blue: part on the board*)
	COR_VAZIO : INT := 252; (*very light grey: empty slot*)
	COR_TINTA : INT := 0; (*black: square drawn*)
	COR_QUADRO : INT := 15; (*white: whiteboard*)
END_VAR
(* Digital twin UDP sender (TwinSender.st). Set TwinHost to the IP of the bridge PC. *)
VAR
	TwinHost : STRING[15] := '192.168.0.100'; (*IP of the bridge PC on the cell network*)
	TwinPort : UINT := 5005; (*UDP port the bridge listens on*)
	TwinLocalPort : UINT := 5006; (*local UDP port on the PLC*)
	TwinOpen : UdpOpen;
	TwinSend : UdpSend;
	TwinTimer : TON;
	TwinPacket : ARRAY[0..27] OF USINT;
	TwinSeq : USINT;
	TwinState : USINT;
	TwinSendErrors : UDINT; (*failed sends, for diagnosis only*)
END_VAR
